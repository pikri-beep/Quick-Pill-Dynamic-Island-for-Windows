{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Quick Pill",
  "version": "5.5.5",
  "identifier": "com.neosparkx.quickpill",
  "build": {
    "frontendDist": "../dist-ui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quick Pill",
        "width": 520,
        "height": 165,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "y": 0,
        "additionalBrowserArgs": "--disable-features=Translate,MediaRouter --js-flags=--max-old-space-size=48"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
